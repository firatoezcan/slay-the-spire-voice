{
  "compilerOptions": {
    "target": "ES2023", "module": "Preserve", "moduleResolution": "bundler", "strict": true,
    "jsx": "react-jsx", "skipLibCheck": true, "allowImportingTsExtensions": true,
    "noEmit": true, "resolveJsonModule": true, "types": ["bun"], "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "references", "dist"]
}
