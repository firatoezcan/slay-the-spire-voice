      "refersTo": "button-primary",
      "description": "The main action in a working region.",
      "html": "<button class=\"ds-button-primary\" type=\"button\">Prepare a transformation</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 10px;border:1px solid transparent;border-radius:var(--radius,0.5rem);font-family:\"Geist Variable\",sans-serif;font-size:14px;font-weight:500;line-height:20px;white-space:nowrap;cursor:pointer;transition:all 150ms cubic-bezier(0.4,0,0.2,1)}.ds-button-primary:focus-visible{border-color:var(--ring,#498767);box-shadow:0 0 0 3px color-mix(in oklab,var(--ring,#498767) 50%,transparent);outline:2px solid var(--ring,#498767);outline-offset:3px}.ds-button-primary:active:not(:disabled){transform:translateY(1px)}.ds-button-primary:disabled{opacity:.5;pointer-events:none}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition-duration:.01ms}}.ds-button-primary{background:var(--primary,#285840);color:var(--primary-foreground,#fff)}.ds-button-primary:hover{background:color-mix(in oklab,var(--primary,#285840) 80%,transparent)}"
