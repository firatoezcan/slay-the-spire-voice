      "description": "The recording control uses this treatment while recording is active.",
      "html": "<button class=\"ds-button-destructive\" type=\"button\">Stop recording</button>",
      "css": ".ds-button-destructive{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 10px;border:1px solid transparent;border-radius:var(--radius,0.5rem);font-family:\"Geist Variable\",sans-serif;font-size:14px;font-weight:500;line-height:20px;white-space:nowrap;cursor:pointer;transition:all 150ms cubic-bezier(0.4,0,0.2,1)}.ds-button-destructive:focus-visible{border-color:var(--ring,#498767);box-shadow:0 0 0 3px color-mix(in oklab,var(--ring,#498767) 50%,transparent);outline:2px solid var(--ring,#498767);outline-offset:3px}.ds-button-destructive:active:not(:disabled){transform:translateY(1px)}.ds-button-destructive:disabled{opacity:.5;pointer-events:none}@media(prefers-reduced-motion:reduce){.ds-button-destructive{transition-duration:.01ms}}.ds-button-destructive{background:color-mix(in oklab,var(--destructive,#a43a31) 10%,transparent);color:var(--destructive,#a43a31)}.ds-button-destructive:hover{background:color-mix(in oklab,var(--destructive,#a43a31) 20%,transparent)}.ds-button-destructive:focus-visible{border-color:color-mix(in oklab,var(--destructive,#a43a31) 40%,transparent);box-shadow:0 0 0 3px color-mix(in oklab,var(--destructive,#a43a31) 20%,transparent)}"
    },
    {
      "name": "Text field",
      "kind": "input",
      "refersTo": "input",
      "description": "The shared compact text input, with visible focus and invalid states.",
      "html": "<input class=\"ds-input\" aria-label=\"Model\" placeholder=\"Model\" />",
      "css": ".ds-input{width:100%;min-width:0;height:32px;padding:4px 10px;border:1px solid var(--input,#cbd5cc);border-radius:var(--radius,.5rem);background:transparent;color:var(--foreground,#26352e);caret-color:var(--primary,#285840);font-family:\"Geist Variable\",sans-serif;font-size:16px;transition:color 150ms cubic-bezier(.4,0,.2,1),border-color 150ms cubic-bezier(.4,0,.2,1)}.ds-input::placeholder{color:var(--muted-foreground,#58645c)}.ds-input:focus-visible{outline:none;border-color:var(--ring,#498767);box-shadow:0 0 0 3px color-mix(in oklab,var(--ring,#498767) 50%,transparent)}.ds-input[aria-invalid=true]{border-color:var(--destructive,#a43a31);box-shadow:0 0 0 3px color-mix(in oklab,var(--destructive,#a43a31) 20%,transparent)}.ds-input:disabled{opacity:.5;cursor:not-allowed;background:color-mix(in oklab,var(--input,#cbd5cc) 50%,transparent)}@media(min-width:768px){.ds-input{font-size:14px}}@media(prefers-reduced-motion:reduce){.ds-input{transition-duration:.01ms}}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Dark navigation with a pale selected item and explicit current-page state.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><button class=\"ds-nav-item\" type=\"button\" aria-current=\"page\">Run</button><button class=\"ds-nav-item\" type=\"button\">Director</button><button class=\"ds-nav-item\" type=\"button\">Voice</button></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:5px;padding:16px;background:#23362f;font-family:\"Geist Variable\",sans-serif}.ds-nav-item{padding:11px 13px;border:0;border-radius:6px;background:transparent;color:#bfcec4;text-align:left;font:inherit;font-size:14px;line-height:1.55;cursor:pointer;transition:background 120ms ease}.ds-nav-item:hover{background:#31483c;color:#fff}.ds-nav-item[aria-current=page]{background:#e4eee5;color:#1f4630;font-weight:600}.ds-nav-item:focus-visible{outline:2px solid var(--ring,#498767);outline-offset:3px}@media(max-width:600px){.ds-nav{flex-direction:row;flex-wrap:wrap;gap:3px}.ds-nav-item{font-size:11px;padding:8px 11px}}@media(prefers-reduced-motion:reduce){.ds-nav-item{transition-duration:.01ms}}"
    },
    {
      "name": "State labels",
      "kind": "chip",
      "refersTo": "state-label",
      "description": "Read-only state text for ordinary, transformed, and failed work.",
      "html": "<span class=\"ds-state\">Original</span> <span class=\"ds-state ds-state-generated\">Transformed</span> <span class=\"ds-state ds-state-failed\">Failed</span>",
      "css": ".ds-state{display:inline-flex;padding:3px 7px;border-radius:4px;background:#eff2ed;color:#5a695f;font-family:\"Geist Variable\",sans-serif;font-size:11px;line-height:1.55}.ds-state-generated{background:#dbe9d6;color:#315333}.ds-state-failed{background:#f8e6df;color:#903d31}"
    },
    {
      "name": "Workspace and inspector",
      "kind": "card",
      "refersTo": "workspace",
      "description": "One flat surface connects the working table with the selected item's details.",
      "html": "<section class=\"ds-workspace\"><div class=\"ds-working-area\"><h2 class=\"ds-workspace-title\">Run cards</h2><p class=\"ds-workspace-copy\">Select a card to inspect it.</p></div><aside class=\"ds-inspector\"><h2 class=\"ds-workspace-title\">Card inspector</h2><p class=\"ds-workspace-copy\">Card details appear here.</p></aside></section>",
      "css": ".ds-workspace{display:grid;grid-template-columns:minmax(0,1fr) 300px;overflow:hidden;border:1px solid var(--border,#d9e0d9);border-radius:10px;background:var(--card,#fff);color:var(--foreground,#26352e);font-family:\"Geist Variable\",sans-serif}.ds-working-area{min-width:0;padding:18px}.ds-inspector{min-width:0;padding:22px;border-left:1px solid var(--border,#d9e0d9);background:#f5f7f2}.ds-workspace-title{margin:0;font-size:17px;font-weight:600;line-height:1.4;letter-spacing:-.015em}.ds-workspace-copy{margin:8px 0 0;color:var(--muted-foreground,#58645c);font-size:12px;line-height:1.55}@media(max-width:1180px){.ds-workspace{grid-template-columns:minmax(0,1fr) 270px}.ds-inspector{padding:18px}}@media(min-width:701px) and (max-width:900px){.ds-workspace{grid-template-columns:minmax(0,1fr) 245px}}@media(max-width:700px){.ds-workspace{grid-template-columns:1fr}.ds-inspector{border-left:0;border-top:1px solid var(--border,#d9e0d9)}}"
    },
    {
      "name": "Selected card row",
      "kind": "custom",
      "refersTo": "selected-row",
      "description": "A named button supplies keyboard access and selection state; the whole row shows the selected fill.",
      "html": "<table class=\"ds-table\"><tbody><tr class=\"ds-row\" data-selected=\"true\"><td><button class=\"ds-card-name\" type=\"button\" aria-pressed=\"true\" aria-controls=\"ds-card-inspector\">Fear into Fury</button><span class=\"ds-rarity\">Common</span></td><td class=\"ds-numeric\">0</td><td>Skill</td></tr></tbody></table><div class=\"ds-inspector-note\" id=\"ds-card-inspector\" aria-label=\"Card inspector\">Selected: Fear into Fury</div>",
      "css": ".ds-table{width:100%;border-collapse:collapse;color:var(--foreground,#26352e);font-family:\"Geist Variable\",sans-serif}.ds-row td{padding:10px 18px;border-bottom:1px solid #edf0ea;font-size:12px;line-height:1.55}.ds-row[data-selected=true] td{background:#eaf1e7}.ds-row:hover td{background:#f3f6ef}.ds-card-name{display:flex;align-items:center;gap:7px;padding:0;border:0;background:transparent;color:inherit;font-family:inherit;font-size:13px;font-weight:560;line-height:1.55;text-align:left;cursor:pointer}.ds-card-name:hover{color:#237047}.ds-card-name:focus-visible{outline:2px solid var(--ring,#498767);outline-offset:3px}.ds-rarity{display:block;margin-top:2px;color:#586552;font-size:10px}.ds-numeric{font-variant-numeric:tabular-nums}.ds-inspector-note{padding:12px;color:var(--muted-foreground,#58645c);font-family:\"Geist Variable\",sans-serif;font-size:11px}@media(prefers-reduced-motion:no-preference){.ds-row[data-selected=true]{animation:ds-select-row 230ms cubic-bezier(.16,1,.3,1)}@keyframes ds-select-row{from{box-shadow:inset 0 0 0 30px #c9dec8}to{box-shadow:inset 0 0 0 0 transparent}}}"
    },
    {
      "name": "Switch",
      "kind": "custom",
      "refersTo": "switch",
      "description": "A compact Base UI switch treatment with a clear label and expanded interaction area.",
      "html": "<div class=\"ds-switch-line\"><span id=\"ds-director-label\">Director enabled</span><button type=\"button\" class=\"ds-switch\" role=\"switch\" aria-checked=\"true\" aria-labelledby=\"ds-director-label\"><span class=\"ds-switch-thumb\"></span></button></div>",
      "css": ".ds-switch-line{display:flex;align-items:center;justify-content:space-between;gap:20px;color:var(--foreground,#26352e);font-family:\"Geist Variable\",sans-serif;font-size:13px;line-height:1.55}.ds-switch{position:relative;display:inline-flex;align-items:center;flex-shrink:0;width:32px;height:18.4px;padding:0;border:1px solid transparent;border-radius:9999px;background:var(--input,#cbd5cc);cursor:pointer;transition:all 150ms cubic-bezier(.4,0,.2,1)}.ds-switch::after{position:absolute;content:\"\";inset:-8px -12px}.ds-switch[aria-checked=true]{background:var(--primary,#285840)}.ds-switch-thumb{display:block;width:16px;height:16px;border-radius:9999px;background:var(--background,#fafbf9);pointer-events:none;transition:transform 150ms cubic-bezier(.4,0,.2,1)}.ds-switch[aria-checked=true] .ds-switch-thumb{transform:translateX(14px)}.ds-switch:focus-visible{border-color:var(--ring,#498767);outline:2px solid var(--ring,#498767);outline-offset:3px;box-shadow:0 0 0 3px color-mix(in oklab,var(--ring,#498767) 50%,transparent)}.ds-switch:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-switch,.ds-switch-thumb{transition-duration:.01ms}}"
    }
  ],
  "narrative": {
    "northStar": "A quiet workspace",
    "overview": "Voice Director uses a quiet green workspace for inspecting game data beside the game. Dark navigation anchors the page; pale surfaces, fine rules, and compact controls keep long tables and explanations easy to read. The visual character comes from the relationship between rows, selection, and detail.\n\nThis document records the implemented dashboard package. The surface strategy remains in [.impeccable/surfaces/apps-dashboard.md](.impeccable/surfaces/apps-dashboard.md), with product constraints in [PRODUCT.md](../../PRODUCT.md). The source is the light theme in src/styles.css and the shadcn components built on Base UI.",
    "keyCharacteristics": [
      "A dark navigation rail and a light working area.",
      "One restrained green accent for actions, selection, and focus.",
      "Compact Geist typography with aligned numbers.",
      "Flat tables and panels separated by fine rules.",
      "Card artwork appears as content inside the inspector."
    ],
    "rules": [
      {
        "name": "The State Rule",
        "body": "Use words and control state alongside color so connection, selection, failure, and pending work remain understandable.",
        "section": "colors"
      },
      {
        "name": "The Reading Rule",
        "body": "Keep supporting text quiet but readable; reserve the smallest type for metadata and counts.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use borders and surface tone to separate persistent content. Reserve floating elevation for temporary overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse the semantic colors and shadcn components built on Base UI.",
      "Do preserve keyboard focus, accessible selection state, and text labels for status.",
      "Do keep numeric data aligned with tabular figures.",
      "Do let the table scroll inside its container while keeping the inspector available at narrow widths.",
      "Do describe pending, offline, and failed actions accurately, including the available recovery.",
      "Do give runtime card artwork a defined content area and a useful loading or failure state."
    ],
    "donts": [
      "Don't treat the unused scaffold dark theme or chart palette as a confirmed dashboard design.",
      "Don't communicate a selected card or a connection state through color alone.",
      "Don't show an unavailable game action as enabled.",
      "Don't turn generated card artwork into a decorative dashboard background.",
      "Don't add promotional copy or invented labels to operational controls."
    ]
  }
}
